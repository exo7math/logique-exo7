\begin{tikzpicture}[scale=1]

\begin{scope}
\coordinate (A0) at (0,0);
\coordinate (A1) at (-1,-1);
\coordinate (A2) at (1,-1);

\coordinate (A11) at (-1.5,-2);
\coordinate (A12) at (-0.5,-2);

\coordinate (A21) at (0.5,-2);
\coordinate (A22) at (1.5,-2);

\coordinate (A211) at (0.1,-3);
\coordinate (A212) at (0.9,-3);


\draw [thick] (A0) -- (A1);
\draw [thick] (A0) -- (A2);
\draw [thick] (A1) -- (A11) node[midway, left,scale=0.7] {$G(x,y_g)$};
\draw [thick] (A1) -- (A12) node[midway, right,scale=0.7] {$D(x,y_d)$};

\draw [thick] (A2) -- (A21);
\draw [thick] (A2) -- (A22);

\draw [thick] (A21) -- (A211);
\draw [thick] (A21) -- (A212);

\foreach \A in {A0, A1, A2, A11, A12, A21, A22, A211, A212}{
	\node at (\A) [circle,fill=black, scale=0.5] {};
}

\node at (A0) [above right]{$r$};
\node at (A1) [above left]{$x$};
\node at (A11) [below=3pt]{$y_g$};
\node at (A12) [below=3pt]{$y_d$};

\end{scope}

\end{tikzpicture}